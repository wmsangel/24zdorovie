# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# сборочные архивы
*.tar.gz

# заливка на хостинг: доступы к cPanel и слепок того, что уже на сервере
scripts/.deploy.env
.deploy-state.json

# автопостинг в Telegram: секреты, состояние очереди и лог
scripts/.tg.env
.tg-state.json
.tg-state.json.tmp
tg-daily.log

# IDE
/.idea/

# локальные выгрузки Cloudflare-трафика (npm run traffic)
/temp/

# локальные настройки Claude Code (разрешения — машинно-специфичны)
.claude/settings.local.json
