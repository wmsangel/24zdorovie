{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    { "source": "/rss", "destination": "/rss/ru.xml", "statusCode": 301 },
    { "source": "/feed", "destination": "/rss/ru.xml", "statusCode": 301 },

    { "source": "/ru/tag/ADF", "destination": "/ru/tag/adf", "statusCode": 301 },
    { "source": "/ru/tag/NEAT", "destination": "/ru/tag/neat", "statusCode": 301 },
    { "source": "/ru/tag/%D0%98%D0%9C%D0%A2", "destination": "/ru/tag/%D0%B8%D0%BC%D1%82", "statusCode": 301 },
    { "source": "/en/tag/BMI", "destination": "/en/tag/bmi", "statusCode": 301 },
    { "source": "/en/tag/CBT-I", "destination": "/en/tag/cbt-i", "statusCode": 301 },
    { "source": "/en/tag/DHA", "destination": "/en/tag/dha", "statusCode": 301 },
    { "source": "/en/tag/EPA", "destination": "/en/tag/epa", "statusCode": 301 },
    { "source": "/en/tag/TDEE", "destination": "/en/tag/tdee", "statusCode": 301 },

    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "locale", "value": "en" }],
      "destination": "/en/",
      "statusCode": 302
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "locale", "value": "ru" }],
      "destination": "/ru/",
      "statusCode": 302
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^en.*" }],
      "destination": "/en/",
      "statusCode": 302
    },
    { "source": "/", "destination": "/ru/", "statusCode": 302 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/:dir(og|covers)/:file*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(xml|txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
