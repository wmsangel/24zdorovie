# ЭТОТ ФАЙЛ ЛЕЖИТ В GIT — здесь только заглушки, никаких реальных токенов.
# Реальные значения идут в scripts/.tg.env, он в .gitignore:
#   cp scripts/.tg.env.example scripts/.tg.env && chmod 600 scripts/.tg.env

# Токен бота от @BotFather. Одного бота хватает на оба канала: в канал он
# публикует от имени канала, собственное имя бота нигде не показывается.
TG_BOT_TOKEN=123456789:AA...

# Если ботов всё-таки два, задать их здесь — они перекроют общий токен выше.
# TG_BOT_TOKEN_RU=123456789:AA...
# TG_BOT_TOKEN_EN=987654321:BB...

# Каналы: @username или числовой chat_id (для приватных каналов только id).
# Бот должен быть администратором канала с правом публикации.
TG_CHANNEL_RU=@zdorovie24Ru
TG_CHANNEL_EN=@zdorovie24En
