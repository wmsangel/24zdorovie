# Доступ к cPanel для scripts/deploy.mjs.
# Скопируйте в scripts/.deploy.env (тот файл в .gitignore) и заполните.

# Хост cPanel. НЕ домен сайта: 24zdorovie.com проксируется Cloudflare,
# и порт 2083 через него не пройдёт. Нужен прямой адрес сервера —
# в панели GoDaddy: Hosting → Settings → Server / cPanel Admin,
# обычно вида xxxxx.prod.iad2.secureserver.net, годится и IP.
CPANEL_HOST=

# Порт cPanel по HTTPS
CPANEL_PORT=2083

# Пользователь cPanel (тот же, что для входа в панель)
CPANEL_USER=

# API-токен: cPanel → Security → Manage API Tokens → Create.
# Токен лучше пароля: его видно один раз, отзывается отдельно от аккаунта.
CPANEL_TOKEN=

# Если хостер отключил токены — вместо CPANEL_TOKEN укажите пароль cPanel.
# CPANEL_PASS=

# Каталог сайта. Обычно public_html; можно указать полный /home/USER/public_html
CPANEL_DIR=public_html

# Необязательно: размер части архива в мегабайтах (по умолчанию 40).
# Уменьшите, если хостинг обрывает загрузку больших файлов.
# DEPLOY_PART_MB=20

# ---------- Cloudflare: сброс кэша после заливки ----------
# Без CF_API_TOKEN шаг просто пропускается с напоминанием.
# Zone ID и Account ID — на странице Overview домена, правая колонка.
CF_ZONE_ID=
CF_ACCOUNT_ID=
# Токен: dash.cloudflare.com → My Profile → API Tokens → Create Token →
# Custom token → Permissions: Zone / Cache Purge / Purge,
# Zone Resources: Include → Specific zone → ваш домен
CF_API_TOKEN=
